# =================================================================
# Production B2B Lead Gen & Multichannel Outreach System Environment
# Target Market: Delhi NCR (Delhi, Noida, Gurugram, Greater Noida)
# =================================================================

# 1. System & Deployment
SYSTEM_ENVIRONMENT=development # development | staging | production
DEFAULT_TIMEZONE=Asia/Kolkata
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# 2. PostgreSQL Database Credentials
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=b2b_outreach
POSTGRES_USER=b2b_admin
POSTGRES_PASSWORD=secure_postgres_pass_2026

# 3. Redis Credentials
REDIS_HOST=localhost
REDIS_PORT=6379

# 4. Google Cloud Platform (Google Sheets CRM & Gmail)
# Create project at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheets-spreadsheet-id-here

# 5. Outbound SMTP / Business Email (Google Workspace / Zoho / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=growth@yourbrandconsulting.in
SMTP_PASSWORD=your-16-digit-app-specific-password
EMAIL_DAILY_PILOT_LIMIT=25

# 6. Meta WhatsApp Cloud API (Official Business API)
# Setup at https://developers.facebook.com/
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_VERIFY_TOKEN=NCR_WHATSAPP_VERIFY_TOKEN_2026
WHATSAPP_DAILY_PILOT_LIMIT=20

# 7. AI Inference API Keys (Leave blank to use built-in deterministic fallbacks)
# Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
# OpenAI Platform: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here

# 8. Webhook Secret Tokens
INBOUND_REPLY_SECRET_TOKEN=secure_inbound_webhook_secret_key_2026
